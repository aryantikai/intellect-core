# Security headers for intellectcore.net (Cloudflare Workers static assets).
# Verify after deploy at https://securityheaders.com/?q=intellectcore.net
#
# Note on 'unsafe-inline': the site ships its CSS and JS inline in one file,
# which is what makes it load in ~350ms. Nonces are not available for static
# assets, so 'unsafe-inline' stays until the CSS/JS are split into files.
# Everything else below is still enforced.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Demo pages are noindex, but noindex is not a lock. Keep crawlers and
# referrers away until they sit behind real access control.
/technical/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
